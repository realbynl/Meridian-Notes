+fn palette_rgb(i: u8) -> (u8, u8, u8) {
+    const BASE: [(u8, u8, u8); 16] = [
+        (0, 0, 0), (205, 0, 0), (0, 205, 0), (205, 205, 0), (0, 0, 238), (205, 0, 205), (0, 205, 205), (229, 229, 229),
+        (127, 127, 127), (255, 0, 0), (0, 255, 0), (255, 255, 0), (92, 92, 255), (255, 0, 255), (0, 255, 255), (255, 255, 255),
+    ];
+    match i {
+        0..=15 => BASE[i as usize],
+        16..=231 => {
+            let n = i - 16;
+            let l = |v: u8| if v == 0 { 0 } else { 55 + 40 * v };
+            (l(n / 36), l(n / 6 % 6), l(n % 6))
+        }
+        _ => {
+            let v = 8 + 10 * (i - 232);
+            (v, v, v)
+        }
+    }
+}
+
+fn nearest(r: u8, g: u8, b: u8, range: std::ops::RangeInclusive<u8>) -> u8 {
+    let d = |p: (u8, u8, u8)| {
+        let sq = |a: u8, b: u8| (a as i32 - b as i32).pow(2);
+        sq(p.0, r) + sq(p.1, g) + sq(p.2, b)
+    };
+    range.min_by_key(|&i| d(palette_rgb(i))).unwrap_or(0)
+}
