+/// How many colours the terminal can show: 16, 256 or 16.7M. `ONYX_COLORS` (16|256|truecolor) overrides detection.
+fn depth() -> u32 {
+    static D: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *D.get_or_init(|| {
+        let env = |k: &str| std::env::var(k).unwrap_or_default().to_lowercase();
+        match env("ONYX_COLORS").as_str() {
+            "16" => return 16,
+            "256" => return 256,
+            "truecolor" | "24bit" => return 1 << 24,
+            _ => {}
+        }
+        let (ct, term) = (env("COLORTERM"), env("TERM"));
+        if ct.contains("truecolor") || ct.contains("24bit") || term.contains("direct") || term.contains("kitty") {
+            1 << 24
+        } else if term.contains("256") || (!ct.is_empty() && term.starts_with("xterm")) {
+            // A desktop terminal (Xfce Terminal sets COLORTERM=Terminal) draws the 256 palette.
+            256
+        } else {
+            16
+        }
+    })
+}
+
+/// Whether the terminal understands DECSCUSR (cursor shape). Old VTE (Xfce Terminal 0.4, the OpenPandora's)
+/// and the Linux console print the sequence's tail as text. `ONYX_CURSOR_SHAPE=0|1` overrides.
+fn cursor_shapes_ok() -> bool {
+    static D: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *D.get_or_init(|| {
+        let env = |k: &str| std::env::var(k).unwrap_or_default();
+        match env("ONYX_CURSOR_SHAPE").as_str() {
+            "0" => return false,
+            "1" => return true,
+            _ => {}
+        }
+        let old_vte = env("VTE_VERSION").parse::<u32>().is_ok_and(|v| v < 3900);
+        !(old_vte || env("TERM") == "linux" || env("COLORTERM") == "Terminal")
+    })
+}
